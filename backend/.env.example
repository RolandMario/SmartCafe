# --- Server ---
PORT=4000
CORS_ORIGINS=*

# --- MongoDB ---
# Local replica set (for transactions): mongodb://localhost:27017/vtu?replicaSet=rs0
# MongoDB Atlas (shared dev cluster):
MONGODB_URI=mongodb+srv://rolandmario2_db_user:bdK7oYdVkooelh2T@cafecluster.adxmo1o.mongodb.net/vtu?retryWrites=true&w=majority

# --- JWT ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Vendor provider: mock | vtpass | ebulksms ---
#   mock     - simulated vendor for local dev (default)
#   vtpass   - VTPass (airtime/data/cable/electricity/WAEC/SMS)
#   ebulksms - eBulkSMS (SMS only; set EBULK_USERNAME / EBULK_API_KEY below)
VENDOR_PROVIDER=vtpass
# Simulate a percentage (0-1) of failed vendor calls for the mock provider
MOCK_FAILURE_RATE=0

# --- VTPass credentials (used when VENDOR_PROVIDER=vtpass) ---
# Base URLs: sandbox https://sandbox.vtpass.com/api | live https://vtpass.com/api
# Auth is header-based (NOT Basic auth): POSTs need VTPASS_API_KEY + VTPASS_SECRET_KEY,
# GETs need VTPASS_API_KEY + VTPASS_PUBLIC_KEY.
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=2acd17c4d346b51bf9abde8645e4c821
VTPASS_SECRET_KEY=SK_417a9e72585049495bf58811e9ef56bbdd121e3426d
VTPASS_PUBLIC_KEY=PK_87010e930911f7b2362935b86abee16b59a976da585

# --- eBulkSMS credentials (used when VENDOR_PROVIDER=ebulksms) ---
# Docs: https://www.ebulksms.com/pages/api-docs | JSON API: /pages/json-api
# Username is your eBulkSMS login (same as your account email).
EBULK_BASE_URL=https://api.ebulksms.com
EBULK_USERNAME=rolandmario2@gmail.com
EBULK_API_KEY=fa78aa01853ad4046e2d125a66b8e9a86261a63e253fd88b9814f46d6e3508f4
VENDOR_PROVIDER=ebulksms
# 0 = normal SMS, 1 = flash SMS (display only, not saved on the phone)
EBULK_FLASH=0
# 0 = skip DND-registered numbers (default), 1 = force delivery to DND with a fixed sender
EBULK_DND=0

# --- Monnify payment gateway (wallet funding) ---
# Set MONNIFY_API_KEY, MONNIFY_SECRET_KEY and MONNIFY_CONTRACT_CODE to turn the
# funding flow into a Monnify hosted checkout. Without them, deposits fall back
# to the manual admin-approval flow.
# Sandbox:   https://sandbox.monnify.com
# Production: https://api.monnify.com
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=MK_TEST_BRD3FDVCRW
MONNIFY_SECRET_KEY=QQMFV3PGS4T3QPTPBCMGB8HG005SJGNA
MONNIFY_CONTRACT_CODE=7443953721
# Where Monnify redirects the customer after payment. Leave empty to derive it
# from the incoming request host (http://<host>/api/funding/webhook/monnify/callback).
MONNIFY_REDIRECT_URL=
# Source IP allow-list for webhooks. Leave empty for no restriction
# (HMAC signature is the primary security control); set to 35.242.133.146 for
# production hardening. Note sandbox/behind-proxy setups may not match the IP.
MONNIFY_ALLOWED_IP=
# Sandbox webhooks carry no HMAC signature — set to true to accept them in dev only.
MONNIFY_WEBHOOK_INSECURE=false

# --- Paystack payment gateway (wallet funding) ---
# Set PAYSTACK_SECRET_KEY to enable Paystack hosted checkout for wallet top-ups.
# Test secret keys look like sk_test_..., live keys sk_live_.... Paystack uses
# the same host for test and live — the key determines the environment.
# The funding flow routes to the gateway the client requests (provider=paystack)
# or the first configured gateway (monnify > paystack) as a default.
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=sk_test_f6436553a3e96c17fd447658dbde28b42ed70af7
# Where Paystack redirects the customer after payment. Leave empty to derive it
# from the incoming request host (http://<host>/api/funding/webhook/paystack/callback).
PAYSTACK_REDIRECT_URL=
# Source IP allow-list for webhooks. Leave empty for no restriction
# (HMAC signature is the primary security control — use your live secret key).
PAYSTACK_ALLOWED_IP=
# Paystack always signs webhooks (HMAC-SHA512) even in sandbox. Keep this false;
# enable only when a dev proxy prevents the x-paystack-signature header.
PAYSTACK_WEBHOOK_INSECURE=false

# --- Email delivery (nodemailer SMTP) ---
# Used to deliver password-reset verification codes by email. If SMTP_HOST is
# left empty the reset code is logged to the server console instead (dev).
# Port 465 is auto-detected as SSL even when SMTP_SECURE is left blank.
# NOTE: this template currently shows local working values — replace them with
# your own credentials for any shared/non-local environment.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rolandmario2@gmail.com
SMTP_PASS=bqwimygwuzfijyxp
# Pin SMTP to IPv4 ('4') when the host has no working IPv6 route — nodemailer
# otherwise resolves both families and may pick an IPv6 address (EHOSTUNREACH
# on IPv4-only networks). Leave empty for nodemailer's default auto behavior.
SMTP_FAMILY=4
MAIL_FROM=SmartCafe <rolandmario2@gmail.com>

