# Mobile app environment
# Unset = hosted backend (https://smart-cafe-bay.vercel.app/api) — see src/api/client.ts.
# For local development against a locally-running backend, the address depends on
# where the app runs:
#   - Android emulator: use http://10.0.2.2:4000/api — 10.0.2.2 is the emulator's
#     alias for your Mac's loopback ("localhost" inside the emulator is the
#     emulator itself, so it cannot reach a backend that only listens locally).
#   - iOS simulator / web: http://localhost:4000/api works (same machine).
#   - Physical phone: use your Mac's LAN IP (NOT localhost — on a physical phone
#     "localhost" refers to the phone itself); phone and Mac must be on the same
#     Wi-Fi network, e.g.:
#EXPO_PUBLIC_API_URL=http://<your-mac-lan-ip>:4000/api
#EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
#EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_API_URL=https://smart-cafe-bay.vercel.app/api
#GROUP_CHAT_URL=https://chat.whatsapp.com/HYZ8oBP3ikz37VPNuPHkHI?s=cl&p=a&mlu=4&ilr=4
# Expo only inlines env vars prefixed with EXPO_PUBLIC_ at build time, so the
# home-screen WhatsApp button reads EXPO_PUBLIC_GROUP_CHAT_URL (the code falls
# back to GROUP_CHAT_URL, then the default link). Keep the two in sync.
EXPO_PUBLIC_GROUP_CHAT_URL=https://chat.whatsapp.com/HYZ8oBP3ikz37VPNuPHkHI?s=cl&p=a&mlu=4&ilr=4